:bublbob1:00000001:F45E:00000000:FFFFFFFF:1st Item = pink sweet:Gives you power-up fire range
:bublbob1:00000001:F45E:00000001:FFFFFFFF:1st Item = blue sweet:Gives you power-up head power
:bublbob1:00000001:F45E:00000002:FFFFFFFF:1st Item = yellow sweet:Gives you power-up fire speed
:bublbob1:00000001:F45E:00000003:FFFFFFFF:1st Item = shoe:Gives you power-up speed
:bublbob1:00000001:F45E:00000004:FFFFFFFF:1st Item = clock:Slows down the monsters
:bublbob1:00000001:F45E:00000005:FFFFFFFF:1st Item = bomb:Turns monsters into diamonds
:bublbob1:00000001:F45E:00000006:FFFFFFFF:1st Item = brown umbrella:Warps you 3 levels farther
:bublbob1:00000001:F45E:00000007:FFFFFFFF:1st Item = red umbrella:Warps you 5 levels farther
:bublbob1:00000001:F45E:00000008:FFFFFFFF:1st Item = pink umbrella:Warps you 7 levels farther
:bublbob1:00000001:F45E:00000009:FFFFFFFF:1st Item = orange potion:Gives a potion of sunflowers
:bublbob1:00000001:F45E:0000000A:FFFFFFFF:1st Item = red potion:Gives a potion of flowers
:bublbob1:00000001:F45E:0000000B:FFFFFFFF:1st Item = green potion:Gives a potion of clovers
:bublbob1:00000001:F45E:0000000C:FFFFFFFF:1st Item = yellow potion:Gives a potion of rainbows
:bublbob1:00000001:F45E:0000000D:FFFFFFFF:1st Item = purple potion:Gives a potion of music notes
:bublbob1:00000001:F45E:0000000E:FFFFFFFF:1st Item = heart:Invincibility&freeze monsters
:bublbob1:00000001:F45E:0000000F:FFFFFFFF:1st Item = blue ring:Gives points when you walk
:bublbob1:00000001:F45E:00000010:FFFFFFFF:1st Item = pink ring:Gives points when you jump
:bublbob1:00000001:F45E:00000011:FFFFFFFF:1st Item = red ring:Gives points when you bubble
:bublbob1:00000001:F45E:00000012:FFFFFFFF:1st Item = blue cross:Fills screen with water
:bublbob1:00000001:F45E:00000013:FFFFFFFF:1st Item = yellow cross:Make lightning strike
:bublbob1:00000001:F45E:00000014:FFFFFFFF:1st Item = orange cross:Fire flames NOT bubbles
:bublbob1:00000001:F45E:00000015:FFFFFFFF:1st Item = blue tea-pot:Pts when you walk.jump&bubble
:bublbob1:00000001:F45E:00000018:FFFFFFFF:1st Item = yellow tea-pot:pwrup fire range+speed& h pwr
:bublbob1:00000001:F45E:00000016:FFFFFFFF:1st Item = red tea-pot:Above two teapots combined
:bublbob1:00000001:F45E:00000017:FFFFFFFF:1st Item = purple tea-pot:Turns monsters into diamonds
:bublbob1:00000001:F45E:00000019:FFFFFFFF:1st Item = book:Turns monsters into diamonds
:bublbob1:00000001:F45E:0000001A:FFFFFFFF:1st Item = grey "ring?":Makes stars fall
:bublbob1:00000001:F45E:0000001B:FFFFFFFF:1st Item = orange necklace:Gives you the EXTEND letters
:bublbob1:00000001:F45E:0000001C:FFFFFFFF:1st Item = grey necklace:Produces a big fireball
